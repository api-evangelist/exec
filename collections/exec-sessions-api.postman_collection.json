        {
          "id": "4423500d-2fd1-4407-a118-b053cb19666f",
          "name": "List roleplay sessions",
          "request": {
            "name": "List roleplay sessions",
            "description": {
              "content": "Returns a paginated list of roleplay sessions in the workspace with inline user and scenario data.\n\nSessions represent individual practice attempts on AI roleplay scenarios. Each session\nincludes the participant's score, rank, duration, and metadata. Use filters to narrow\nresults by user, scenario, skill, program, group, or date range.\n\nNote: Sessions may include users who are no longer active workspace members (e.g., users\nwho have been removed). These users will not appear in GET /workspace/members but their\nhistorical session data is preserved.\n\nResults are ordered by creation date (newest first) by default.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "sessions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "user_ids",
                  "value": "<string>",
                  "description": "Comma-separated user IDs to filter by. When combined with user_emails, results are unioned (all matching users from either list are included)."
                },
                {
                  "disabled": false,
                  "key": "user_emails",
                  "value": "<string>",
                  "description": "Comma-separated user email addresses to filter by. When combined with user_ids, results are unioned (all matching users from either list are included)."
                },
                {
                  "disabled": false,
                  "key": "scenario_ids",
                  "value": "<string>",
                  "description": "Comma-separated scenario IDs to filter by"
                },
                {
                  "disabled": false,
                  "key": "collection_ids",
                  "value": "<string>",
                  "description": "Comma-separated collection IDs to filter by"
                },
                {
                  "disabled": false,
                  "key": "skill_ids",
                  "value": "<string>",
                  "description": "Comma-separated skill IDs to filter by"
                },
                {
                  "disabled": false,
                  "key": "program_ids",
                  "value": "<string>",
                  "description": "Comma-separated program IDs to filter by"
                },
                {
                  "disabled": false,
                  "key": "group_ids",
                  "value": "<string>",
                  "description": "Comma-separated workspace group IDs to filter by"
                },
                {
                  "disabled": false,
                  "key": "rank",
                  "value": "<string>,<string>",
                  "description": "Filter by one or more performance ranks"
                },
                {
                  "disabled": false,
                  "key": "start_date",
                  "value": "<dateTime>",
                  "description": "ISO 8601 datetime — only include sessions created on or after this date"
                },
                {
                  "disabled": false,
                  "key": "end_date",
                  "value": "<dateTime>",
                  "description": "ISO 8601 datetime — only include sessions created on or before this date"
                },
                {
                  "disabled": false,
                  "key": "exclude_system_users",
                  "value": "false",
                  "description": "Exclude sessions from system users (emails ending in @exec.com). Default false."
                },
                {
                  "disabled": false,
                  "key": "sorting",
                  "value": "-created_at",
                  "description": "Sort field. Prefix with `-` for descending order."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Page number (1-indexed)"
                },
                {
                  "disabled": false,
                  "key": "page_size",
                  "value": "50",
                  "description": "Number of results per page (max 100)"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
