        {
          "id": "27572d68-a324-4bfd-bf34-505b10ae0023",
          "name": "Get session detail",
          "request": {
            "name": "Get session detail",
            "description": {
              "content": "Returns full detail for a single roleplay session, including score, rank, duration,\nand feedback.\n\nUse the `include` parameter to fetch optional heavy fields like the full conversation\ntranscript or evaluation criteria with grades. These are omitted by default to keep\nresponses lean.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "sessions",
                ":session_id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "include",
                  "value": "<string>",
                  "description": "Comma-separated list of optional sections to include in the response.\nAvailable values: `transcript` (conversation lines), `evaluations` (rubric criteria with grades).\n"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "session_id",
                  "description": "(Required) The session's unique identifier (UUID)"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
