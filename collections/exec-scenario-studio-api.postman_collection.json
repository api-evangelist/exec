          "item": [
            {
              "name": "{job_id}",
              "item": [
                {
                  "name": "Get Scenario job status",
                  "id": "3ef9cff7-548f-4127-a684-75dbb9476d28",
                  "protocolProfileBehavior": {
                    "disableBodyPruning": true
                  },
                  "request": {
                    "method": "GET",
                    "header": [
                      {
                        "key": "Accept",
                        "value": "application/json"
                      }
                    ],
                    "url": {
                      "raw": "{{baseUrl}}/scenario-studio/jobs/:job_id",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "scenario-studio",
                        "jobs",
                        ":job_id"
                      ],
                      "variable": [
                        {
                          "id": "31633829-7da7-456f-8ac8-557bc3982d47",
                          "key": "job_id",
                          "value": "<string>",
                          "description": "(Required) The job ID returned from job creation"
                        }
                      ]
                    },
                    "description": "Returns the current status and result of a scenario creation job.\n\nPoll this endpoint to check job progress. Typical job duration is about 5 minutes.\n\n**Job statuses:**\n- `queued`: Job is waiting to be processed\n- `processing`: AI agent is actively creating the scenario\n- `completed`: Scenario created successfully (check `scenario` field)\n- `failed`: Job failed (check `error` field for details)\n- `cancelled`: Job was cancelled via DELETE"
                  },
                  "response": [
                    {
                      "id": "98b96c14-5d75-4bb7-92ba-10f57d64f636",
                      "name": "Job status and result",
                      "originalRequest": {
                        "method": "GET",
                        "header": [
                          {
                            "key": "Accept",
                            "value": "application/json"
                          },
                          {
                            "description": "Added as a part of security scheme: bearer",
                            "key": "Authorization",
                            "value": "Bearer <token>"
                          }
                        ],
                        "url": {
                          "raw": "{{baseUrl}}/scenario-studio/jobs/:job_id",
                          "host": [
                            "{{baseUrl}}"
                          ],
                          "path": [
                            "scenario-studio",
                            "jobs",
                            ":job_id"
                          ],
                          "variable": [
                            {
                              "key": "job_id"
                            }
                          ]
                        }
                      },
                      "status": "OK",
                      "code": 200,
                      "_postman_previewlanguage": "json",
                      "header": [
                        {
                          "key": "Content-Type",
                          "value": "application/json"
                        }
                      ],
                      "cookie": [],
                      "responseTime": null,
                      "body": "{\n  \"id\": \"<string>\",\n  \"status\": \"completed\",\n  \"scenario\": {\n    \"id\": \"<string>\",\n    \"name\": \"<string>\",\n    \"url\": \"<uri>\"\n  },\n  \"error\": null,\n  \"created_at\": \"<dateTime>\",\n  \"started_at\": \"<string,null-date-time>\",\n  \"completed_at\": \"<string,null-date-time>\",\n  \"duration_seconds\": \"<number,null>\"\n}",
