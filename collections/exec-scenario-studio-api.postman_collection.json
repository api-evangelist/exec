        {
          "id": "786c0560-4338-40e8-ba99-cd7963bbea48",
          "name": "Create Scenario job",
          "request": {
            "name": "Create Scenario job",
            "description": {
              "content": "Creates an asynchronous scenario creation job.\nReturns immediately with a job ID that can be polled for status.\n\nThe AI agent processes the job in the background, typically completing\nwithin 5 minutes. Use the GET endpoint to poll for completion,\nor provide a `callback_url` to receive a webhook when the job finishes.\n\n**Remix mode**: Provide `scenario_slug` to create a variation of an existing\nscenario. The AI will use the source scenario as a starting point and apply\nyour prompt as modifications.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "scenario-studio",
                "jobs"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
