        {
          "id": "b8ce3d04-adb4-4a33-9742-2ee8164c0704",
          "name": "Cancel Scenario job",
          "request": {
            "name": "Cancel Scenario job",
            "description": {
              "content": "Cancels a scenario creation job that is queued or processing.\n\n- **Queued jobs**: Marked as cancelled immediately\n- **Processing jobs**: The background task is terminated and the job is marked cancelled\n- **Completed/failed/cancelled jobs**: Returns 400 error (cannot cancel terminal states)\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "scenario-studio",
                "jobs",
                ":job_id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "job_id",
                  "description": "(Required) The job ID to cancel"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
