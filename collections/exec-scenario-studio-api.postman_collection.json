        {
          "id": "7631da40-1287-44f7-bce4-bd9fd0603f5b",
          "name": "Get Scenario job status",
          "request": {
            "name": "Get Scenario job status",
            "description": {
              "content": "Returns the current status and result of a scenario creation job.\n\nPoll this endpoint to check job progress. Typical job duration is about 5 minutes.\n\n**Job statuses:**\n- `queued`: Job is waiting to be processed\n- `processing`: AI agent is actively creating the scenario\n- `completed`: Scenario created successfully (check `scenario` field)\n- `failed`: Job failed (check `error` field for details)\n- `cancelled`: Job was cancelled via DELETE\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "scenario-studio",
                "jobs",
                ":job_id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "job_id",
                  "description": "(Required) The job ID returned from job creation"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
