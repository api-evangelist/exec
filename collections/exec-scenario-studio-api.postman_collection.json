            {
              "name": "Create Scenario job",
              "id": "3f58779d-603f-4385-8fd5-e13c9ceea16c",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"user_email\": \"<email>\",\n  \"prompt\": \"<string>\",\n  \"context\": \"<string>\",\n  \"scenario_slug\": \"<string>\",\n  \"request_id\": \"<string>\",\n  \"callback_url\": \"<uri>\",\n  \"callback_headers\": {\n    \"eiusmod_2\": \"<string>\",\n    \"aliqua_3\": \"<string>\",\n    \"aute46\": \"<string>\",\n    \"irure_520\": \"<string>\"\n  }\n}",
                  "options": {
                    "raw": {
                      "headerFamily": "json",
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/scenario-studio/jobs",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "scenario-studio",
                    "jobs"
                  ]
                },
                "description": "Creates an asynchronous scenario creation job.\nReturns immediately with a job ID that can be polled for status.\n\nThe AI agent processes the job in the background, typically completing\nwithin 5 minutes. Use the GET endpoint to poll for completion,\nor provide a `callback_url` to receive a webhook when the job finishes.\n\n**Remix mode**: Provide `scenario_slug` to create a variation of an existing\nscenario. The AI will use the source scenario as a starting point and apply\nyour prompt as modifications."
              },
