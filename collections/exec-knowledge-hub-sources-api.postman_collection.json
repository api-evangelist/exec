          "name": "List sources",
          "request": {
            "name": "List sources",
            "description": {
              "content": "Returns a paginated list of Knowledge Hub sources. List rows are metadata\nonly — pass `?include=content` on the detail endpoint to fetch the\nextracted text.\n\nFilter by type, status, folder, or free-text query.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "knowledge-hub",
                "sources"
              ],
              "host": [
                "{{baseUrl}}"
              ],
