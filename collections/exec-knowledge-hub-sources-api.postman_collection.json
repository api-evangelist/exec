        {
          "id": "de54f00e-5c3d-463e-9642-263b5f4fac80",
          "name": "Create source",
          "request": {
            "name": "Create source",
            "description": {
              "content": "Creates a Knowledge Hub source from a URL. Text extraction runs\nasynchronously, so the source is returned with `status: pending` or\n`processing`; poll the detail endpoint until `status` is `ready`.\n\nURL sources are de-duplicated within the workspace: if the URL already\nexists, the existing source is returned with status `200` instead of\n`201`.\n\n> File upload via the REST API is not yet supported — use URL ingest.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "knowledge-hub",
                "sources"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"<string>\",\n  \"title\": \"<string>\",\n  \"url\": \"<uri>\",\n  \"cover\": \"<string>\",\n  \"folder_ids\": [\n    \"<string>\",\n    \"<string>\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
