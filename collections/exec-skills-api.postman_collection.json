                      "value": "<string>"
                    },
                    {
                      "description": "Page number (1-indexed)",
                      "key": "page",
                      "value": "1"
                    },
                    {
                      "description": "Number of results per page (max 100)",
                      "key": "page_size",
                      "value": "50"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
