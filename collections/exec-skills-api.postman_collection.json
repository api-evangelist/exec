        {
          "name": "List skills",
          "id": "9bcf97b5-abaa-4f2a-a535-c3c6ec352993",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/skills?include=<string>&page=1&page_size=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "skills"
              ],
              "query": [
                {
                  "description": "Comma-separated list of optional data to include.\nAvailable values: `proficiency` (aggregate proficiency stats per skill).\n",
                  "key": "include",
                  "value": "<string>"
                },
                {
                  "description": "Page number (1-indexed)",
                  "key": "page",
                  "value": "1"
                },
                {
                  "description": "Number of results per page (max 100)",
                  "key": "page_size",
                  "value": "50"
                }
              ]
            },
            "description": "Returns a paginated list of skills in the workspace, ordered alphabetically by name.\n\nSkills represent competencies that are evaluated during roleplay sessions and calls\n(e.g. \"Discovery Questions\", \"Objection Handling\", \"Procurement Selling\"). Each skill\ncan be linked to evaluation criteria across multiple scenarios.\n\nUse `?include=proficiency` to add aggregate proficiency stats per skill (participant\ncount, scored participant count, percentage proficient+, and average score). This is\ncomputed across all workspace members who have practiced each skill."
          },
          "response": [
            {
              "id": "198ab005-b562-4769-869f-21c4899c703f",
              "name": "Paginated list of skills",
              "originalRequest": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  },
                  {
                    "description": "Added as a part of security scheme: bearer",
