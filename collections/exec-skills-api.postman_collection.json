        {
          "id": "e097faae-93ab-4d5a-aa87-168c3136b4e7",
          "name": "List skills",
          "request": {
            "name": "List skills",
            "description": {
              "content": "Returns a paginated list of skills in the workspace, ordered alphabetically by name.\n\nSkills represent competencies that are evaluated during roleplay sessions and calls\n(e.g. \"Discovery Questions\", \"Objection Handling\", \"Procurement Selling\"). Each skill\ncan be linked to evaluation criteria across multiple scenarios.\n\nUse `?include=proficiency` to add aggregate proficiency stats per skill (participant\ncount, scored participant count, percentage proficient+, and average score). This is\ncomputed across all workspace members who have practiced each skill.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "skills"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "include",
                  "value": "<string>",
                  "description": "Comma-separated list of optional data to include.\nAvailable values: `proficiency` (aggregate proficiency stats per skill).\n"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Page number (1-indexed)"
                },
                {
                  "disabled": false,
                  "key": "page_size",
                  "value": "50",
                  "description": "Number of results per page (max 100)"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "55277e64-6c41-4496-808b-889e161d0d7d",
