        {
          "id": "d7f012f1-211f-4bfa-a4ce-6bdac8e4182a",
          "name": "Get skill proficiency by user",
          "request": {
            "name": "Get skill proficiency by user",
            "description": {
              "content": "Returns per-user proficiency data for a specific skill.\n\nProficiency uses time-decay weighted scoring across all observations (roleplay sessions\nand calls combined). Recent observations count more than older ones (30-day half-life).\nA minimum of 3 observations is required before a proficiency score is calculated.\n\nProficiency tiers: `excellent` (≥90), `proficient` (≥75), `developing` (≥50),\n`needs_work` (<50), `insufficient_data` (<3 observations).\n\nOnly users with at least one observation are included in the response. If no user\nfilters are provided, returns proficiency for all workspace members who have practiced\nthis skill.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "skills",
                ":skill_id",
                "proficiency"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "user_ids",
                  "value": "<string>",
                  "description": "Comma-separated user IDs to filter by. When combined with user_emails, results are unioned (all matching users from either list are included)."
                },
                {
                  "disabled": false,
                  "key": "user_emails",
                  "value": "<string>",
                  "description": "Comma-separated user email addresses to filter by. When combined with user_ids, results are unioned (all matching users from either list are included)."
                },
                {
                  "disabled": false,
                  "key": "group_ids",
                  "value": "<string>",
                  "description": "Comma-separated workspace group IDs to filter by"
                },
                {
                  "disabled": false,
                  "key": "end_date",
                  "value": "<dateTime>",
                  "description": "Calculate proficiency as of this date (ISO 8601). Defaults to now."
                },
                {
                  "disabled": false,
                  "key": "exclude_system_users",
                  "value": "false",
                  "description": "Exclude sessions from system users (emails ending in @exec.com). Default false."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Page number (1-indexed)"
                },
                {
                  "disabled": false,
                  "key": "page_size",
                  "value": "50",
                  "description": "Number of results per page (max 100)"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "skill_id",
                  "description": "(Required) The skill's unique identifier (UUID)"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
