                      "raw": "{{baseUrl}}/skills/:skill_id/proficiency?user_ids=<string>&user_emails=<string>&group_ids=<string>&end_date=<dateTime>&exclude_system_users=false&page=1&page_size=50",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "skills",
                        ":skill_id",
                        "proficiency"
                      ],
                      "query": [
                        {
                          "description": "Comma-separated user IDs to filter by. When combined with user_emails, results are unioned (all matching users from either list are included).",
                          "key": "user_ids",
                          "value": "<string>"
                        },
                        {
                          "description": "Comma-separated user email addresses to filter by. When combined with user_ids, results are unioned (all matching users from either list are included).",
                          "key": "user_emails",
                          "value": "<string>"
                        },
                        {
                          "description": "Comma-separated workspace group IDs to filter by",
                          "key": "group_ids",
                          "value": "<string>"
                        },
                        {
                          "description": "Calculate proficiency as of this date (ISO 8601). Defaults to now.",
                          "key": "end_date",
                          "value": "<dateTime>"
                        },
                        {
                          "description": "Exclude sessions from system users (emails ending in @exec.com). Default false.",
                          "key": "exclude_system_users",
                          "value": "false"
                        },
                        {
                          "description": "Page number (1-indexed)",
                          "key": "page",
                          "value": "1"
                        },
                        {
                          "description": "Number of results per page (max 100)",
                          "key": "page_size",
                          "value": "50"
                        }
                      ],
                      "variable": [
                        {
                          "id": "ea438117-019c-45ab-bc31-df56c93d2b29",
                          "key": "skill_id",
                          "value": "<string>",
                          "description": "(Required) The skill's unique identifier (UUID)"
                        }
                      ]
                    },
                    "description": "Returns per-user proficiency data for a specific skill.\n\nProficiency uses time-decay weighted scoring across all observations (roleplay sessions\nand calls combined). Recent observations count more than older ones (30-day half-life).\nA minimum of 3 observations is required before a proficiency score is calculated.\n\nProficiency tiers: `excellent` (\u226590), `proficient` (\u226575), `developing` (\u226550),\n`needs_work` (<50), `insufficient_data` (<3 observations).\n\nOnly users with at least one observation are included in the response. If no user\nfilters are provided, returns proficiency for all workspace members who have practiced\nthis skill."
                  },
