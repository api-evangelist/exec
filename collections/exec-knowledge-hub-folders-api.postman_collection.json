            {
              "name": "List folders",
              "id": "e692dea4-ce5b-493a-bf58-2878f4f10115",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/knowledge-hub/folders?parent_id=<string>&query=<string>&page=1&page_size=50",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "knowledge-hub",
                    "folders"
                  ],
                  "query": [
                    {
                      "description": "Return only the direct children of this folder (folder UUID). Omit to list all folders.",
                      "key": "parent_id",
                      "value": "<string>"
                    },
                    {
                      "description": "Case-insensitive search over folder names",
                      "key": "query",
                      "value": "<string>"
                    },
                    {
                      "description": "Pagination page number (1-indexed) \u2014 which page of results to return, not a Knowledge Hub page.",
                      "key": "page",
                      "value": "1"
                    },
                    {
                      "description": "Number of results per page (max 100)",
                      "key": "page_size",
                      "value": "50"
                    }
                  ]
                },
                "description": "Returns a paginated list of Knowledge Hub folders (also called Spaces or\nHubs) in the workspace.\n\nFolders group pages and sources, and can be nested to form a hierarchy.\nPass `parent` to list the direct children of a folder, or omit it to list\nevery folder in the workspace.\n\nAPI keys are workspace-scoped and admin-created, so the response includes\nevery non-archived folder regardless of its visibility scope."
              },
              "response": [
                {
                  "id": "7b9f3edc-79a2-4739-8c3c-824910ba310f",
                  "name": "Paginated list of folders",
                  "originalRequest": {
                    "method": "GET",
                    "header": [
                      {
                        "key": "Accept",
                        "value": "application/json"
                      },
                      {
                        "description": "Added as a part of security scheme: bearer",
                        "key": "Authorization",
                        "value": "Bearer <token>"
                      }
                    ],
                    "url": {
                      "raw": "{{baseUrl}}/knowledge-hub/folders?parent_id=<string>&query=<string>&page=1&page_size=50",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "knowledge-hub",
                        "folders"
                      ],
                      "query": [
                        {
                          "description": "Return only the direct children of this folder (folder UUID). Omit to list all folders.",
                          "key": "parent_id",
                          "value": "<string>"
                        },
                        {
                          "description": "Case-insensitive search over folder names",
                          "key": "query",
                          "value": "<string>"
                        },
                        {
                          "description": "Pagination page number (1-indexed) \u2014 which page of results to return, not a Knowledge Hub page.",
                          "key": "page",
                          "value": "1"
                        },
                        {
                          "description": "Number of results per page (max 100)",
                          "key": "page_size",
                          "value": "50"
                        }
                      ]
                    }
                  },
                  "status": "OK",
                  "code": 200,
                  "_postman_previewlanguage": "json",
