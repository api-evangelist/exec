      "item": [
        {
          "id": "3f849682-b440-45bf-9359-7fb7cd103e5f",
          "name": "List folders",
          "request": {
            "name": "List folders",
            "description": {
              "content": "Returns a paginated list of Knowledge Hub folders (also called Spaces or\nHubs) in the workspace.\n\nFolders group pages and sources, and can be nested to form a hierarchy.\nPass `parent` to list the direct children of a folder, or omit it to list\nevery folder in the workspace.\n\nAPI keys are workspace-scoped and admin-created, so the response includes\nevery non-archived folder regardless of its visibility scope.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "knowledge-hub",
                "folders"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "parent_id",
                  "value": "<string>",
                  "description": "Return only the direct children of this folder (folder UUID). Omit to list all folders."
                },
                {
                  "disabled": false,
                  "key": "query",
                  "value": "<string>",
                  "description": "Case-insensitive search over folder names"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Pagination page number (1-indexed) — which page of results to return, not a Knowledge Hub page."
                },
                {
                  "disabled": false,
                  "key": "page_size",
                  "value": "50",
                  "description": "Number of results per page (max 100)"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "1a00e4fc-a2d7-45a3-87f6-abc196c59f33",
